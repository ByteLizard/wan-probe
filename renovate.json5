{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Auto-merge low-risk updates once CI is green.
  packageRules: [
    {
      // Patch + minor self-merge once CI is green. platformAutomerge:false →
      // Renovate self-merges after checking CI (no GitHub branch protection /
      // Pro needed).
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      platformAutomerge: false,
    },
    {
      // Stateful/critical deps stay human-gated even for patches — a bad bump
      // here is a functional regression, not just a supply-chain risk. Add
      // depNames here: databases, the IdP, object storage, OS/k8s. This rule is
      // AFTER the automerge one, so automerge:false wins for these.
      matchDepNames: [],
      automerge: false,
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
  // A CVE fix does NOT auto-merge — a "CVE fix" is itself a supply-chain
  // vector, so it goes through HUMAN REVIEW. Labelled security.
  vulnerabilityAlerts: {
    automerge: false,
    addLabels: ["security"],
  },
  osvVulnerabilityAlerts: true,
}
